      .visibility(this.show0 === '1' ? Visibility.None : Visibility.Visible)
      .onClick(() => this.openVideo(''))

      Column({ space: 8 }) {
        Column({ space: 4 }) {
          Row() {
            Text(this.platform0)
              .fontSize(11)
              .fontColor('#2F6BFF')
              .backgroundColor('#E8F0FF')
              .padding({ left: 6, right: 6, top: 2, bottom: 2 })
              .borderRadius(6)
            Blank()
            Text(this.extra0)
              .fontSize(11)
              .fontColor('#637083')
          }.width('100%')
          Text(this.title0)
            .fontSize(15)
            .fontWeight(FontWeight.Medium)
            .fontColor('#1C2430')
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .width('100%')
        }
        .width('100%')
        .padding(10)
        .backgroundColor(Color.White)
        .borderRadius(12)
        .visibility(this.show0 === '1' ? Visibility.Visible : Visibility.None)
        .onClick(() => this.openVideo(this.url0))

        Column({ space: 4 }) {
          Row() {
            Text(this.platform1)
              .fontSize(11)
              .fontColor('#2F6BFF')
              .backgroundColor('#E8F0FF')
              .padding({ left: 6, right: 6, top: 2, bottom: 2 })
              .borderRadius(6)
            Blank()
            Text(this.extra1)
              .fontSize(11)
              .fontColor('#637083')
          }.width('100%')
          Text(this.title1)
            .fontSize(15)
            .fontWeight(FontWeight.Medium)
            .fontColor('#1C2430')
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .width('100%')
        }
        .width('100%')
        .padding(10)
        .backgroundColor(Color.White)
        .borderRadius(12)
        .visibility(this.show1 === '1' ? Visibility.Visible : Visibility.None)
        .onClick(() => this.openVideo(this.url1))

        Column({ space: 4 }) {
          Row() {
            Text(this.platform2)
              .fontSize(11)
              .fontColor('#2F6BFF')
              .backgroundColor('#E8F0FF')
              .padding({ left: 6, right: 6, top: 2, bottom: 2 })
              .borderRadius(6)
            Blank()
            Text(this.extra2)
              .fontSize(11)
              .fontColor('#637083')
          }.width('100%')
          Text(this.title2)
            .fontSize(15)
            .fontWeight(FontWeight.Medium)
            .fontColor('#1C2430')
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .width('100%')
        }
        .width('100%')
        .padding(10)
        .backgroundColor(Color.White)
        .borderRadius(12)
        .visibility(this.show2 === '1' ? Visibility.Visible : Visibility.None)
        .onClick(() => this.openVideo(this.url2))
      }
      .width('100%')
      .visibility(this.show0 === '1' ? Visibility.Visible : Visibility.None)
    }
    .width('100%')
    .height('100%')
    .padding(14)
    .backgroundColor('#F7F9FC')
  }
}
